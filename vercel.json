{
  "rewrites": [
    { "source": "/((?!art/|assets/|fonts/|favicon.svg|icons.svg|robots.txt|sitemap.xml|llms.txt|.well-known/|_vercel/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(art|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
